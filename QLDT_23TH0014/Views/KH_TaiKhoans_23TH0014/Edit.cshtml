@model QLDT_23TH0014.Models.NguoiDung

@{
    ViewBag.Title = "Chỉnh sửa thông tin";
    Layout = "~/Views/Shared/_LayoutKH.cshtml";
    <link href="~/Content/Style.css" rel="stylesheet" />

    // Upload file ảnh
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
    <script type="text/javascript">
        $(function () {
            var fileupload = $("#Avatar");
            var image = $("#FileUpload");
            image.click(function () {
                fileupload.click();
            });
            fileupload.change(function () {
                var fileName = $(this).val().split('\\')[$(this).val().split('\\').length - 1];
                document.getElementById("AnhDaiDien").value = fileName;
            });
        });
    </script>
}
<div class="container mt-4">
    <div class="card shadow-lg pb-4" style="max-width: 70%; margin: 0 auto;">
        <div class="card-header brand-header text-center">
            Chỉnh sửa thông tin
        </div>
        <div class="card-body">
            @if (ViewBag.TB != null)
            {
                <div class="alert alert-danger" style="text-align: center">@ViewBag.TB</div>
            }
            <div class="row pt-2">
                <div class="col-md-6 m-auto">
                    @using (Html.BeginForm("Edit", "KH_TaiKhoans_23TH0014", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.MaNguoiDung)
                        @Html.HiddenFor(model => model.VaiTro)
                        <table class="table1" align="center" cellpadding="8">
                            <tr>
                                <td><label class="form-label"><strong>Họ và tên:</strong></label></td>
                                <td>
                                    @Html.EditorFor(model => model.HoTen, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label"><strong>Giới tính:</strong></label></td>
                                <td>
                                    <div class="checkbox">
                                        Nam @Html.RadioButtonFor(model => model.GioiTinh, "True", new { @checked = "checked" }) &nbsp;
                                        Nữ @Html.RadioButtonFor(model => model.GioiTinh, "False")
                                        @Html.ValidationMessageFor(model => model.GioiTinh, "", new { @class = "text-danger" })
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label"><strong>Số điện thoại:</strong></label></td>
                                <td>
                                    @Html.EditorFor(model => model.SDT, new
                                    {
                                        htmlAttributes = new
                                        {
                                            @class = "form-control",
                                            required = "required",
                                            pattern = @"^\d{10}$",
                                            title = "Số điện thoại phải có 10 chữ số."
                                        }
                                    })
                                    @Html.ValidationMessageFor(model => model.SDT, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label"><strong>Email:</strong></label></td>
                                <td>
                                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label"><strong>Mật khẩu:</strong></label></td>
                                <td>
                                    @Html.EditorFor(model => model.MatKhau, new
                                    {
                                        htmlAttributes = new
                                        {
                                            @class = "form-control",
                                            style = "border-radius: 5px; width: 100%;",
                                            required = "required",
                                            minlength = "6",
                                            title = "Mật khẩu phải có ít nhất 6 ký tự."
                                        }
                                    })
                                    @Html.ValidationMessageFor(model => model.MatKhau, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label"><strong>Địa chỉ:</strong></label></td>
                                <td>
                                    @Html.EditorFor(model => model.DiaChi, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.DiaChi, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><label class="form-label"><strong>Ảnh đại diện:</strong></label></td>
                                <td>
                                    @Html.EditorFor(model => model.AnhDaiDien, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.AnhDaiDien, "", new { @class = "text-danger" })
                                    <input type="file" name="Avatar" id="Avatar" />
                                </td>
                            </tr>
                        </table>
                        <div class="text-center d-flex justify-content-center gap-2 mt-4">
                            <a href="@Url.Action("Details", "KH_TaiKhoans_23TH0014", new { id = Model.MaNguoiDung })" class="btn" style="border-radius: 5px; background: #fd710d; color: white">Quay lại</a>
                            <button type="submit" class="btn" style="border-radius: 5px; background: #fe6161; color: white">Lưu</button>
                        </div>
                    }
                </div>
            </div>
        </div>        
    </div>
</div>

