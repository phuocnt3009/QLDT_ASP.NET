@model QLDT_23TH0014.Models.ChiTietSanPham
@{
    ViewBag.Title = "Chỉnh sửa ảnh sản phẩm";
    Layout = "~/Views/Shared/_LayoutKH.cshtml";
    <link href="~/Content/Style.css" rel="stylesheet" />

    // Upload file ảnh
    <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
    <script type="text/javascript">
    $(function () {
            var fileupload = $("#Avatar");
            var image = $("#FileUpload");
            image.click(function () {
                fileupload.click();
            });
            fileupload.change(function () {
                var fileName = $(this).val().split('\\')[$(this).val().split('\\').length - 1];
                document.getElementById("AnhBia").value = fileName;
            });
        });</script>
}
<div class="container mt-4">
    <div class="card shadow-lg pb-4" style="max-width: 70%; margin: 0 auto;">
        <div class="card-header brand-header text-center" style="margin-bottom: 20px;">
            Chỉnh sửa ảnh sản phẩm
        </div>
        <div class="row p-4">
            <!-- Hỉnh ảnh sản phẩm -->
            <div class="col-md-6 d-flex align-items-center justify-content-center">
                <div class="p-3">
                    <img src="~/Images/SanPham/@Model.AnhBia" class="img-fluid" style="max-width: 300px; height: 300px">
                </div>
            </div>
            <!-- Form chỉnh sửa -->
            <div class="col-md-6 d-flex flex-column justify-content-center">
                @using (Html.BeginForm("Edit_Anh", "NV_SanPhams_23TH0014", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.MaSP)
                    @Html.HiddenFor(model => model.MaMau)
                    <table class="table1 w-100" align="center" cellpadding="8">
                        <tr>
                            <td><label class="form-label"><strong>Sản phẩm:</strong></label></td>
                            <td>
                                <input type="text" class="form-control" value="@Model.SanPham.TenSP" disabled readonly />
                            </td>
                        </tr>
                        <tr>
                            <td><label class="form-label"><strong>Màu sắc:</strong></label></td>
                            <td>
                                <input type="text" class="form-control" value="@Model.MauSac.TenMau" disabled readonly />
                            </td>
                        </tr>
                        <tr>
                            <td><label class="form-label"><strong>Ảnh bìa:</strong></label></td>
                            <td>
                                @Html.EditorFor(model => model.AnhBia, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.AnhBia, "", new { @class = "text-danger" })
                                <input type="file" name="Avatar" id="Avatar" class="mt-2" />
                            </td>
                        </tr>
                    </table>
                    <div class="d-flex justify-content-center gap-2 mt-4 mb-3">
                        <a href="@Url.Action("Details", "NV_SanPhams_23TH0014", new { id = Model.MaSP })"
                           class="btn" style="border-radius: 5px; background: #fd710d; color: white">Quay lại</a>
                        <button type="submit" class="btn" style="border-radius: 5px; background: #fe6161; color: white">Lưu</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

