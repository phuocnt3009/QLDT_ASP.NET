@model QLDT_23TH0014.Models.NguoiDung
@{
    ViewBag.Title = "Thêm người dùng";
    Layout = "~/Views/Shared/_LayoutNV.cshtml";
    <link href="~/Content/Style.css" rel="stylesheet" />
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header brand-header text-center" style="background-color: #fd710d; color: white; font-weight: bold; font-size: 18px;">
                    Thêm người dùng
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("Create", "NV_TaiKhoans_23TH0014", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        <table class="table1" align="center" cellpadding="8">
                            <tr>
                                <td><strong>Mã người dùng:</strong></td>
                                <td>
                                    <input type="text" value="@ViewBag.MaNguoiDung" disabled readonly class="form-control" />
                                    @Html.ValidationMessageFor(model => model.MaNguoiDung, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Họ và tên:</strong></td>
                                <td>
                                    @Html.TextBoxFor(model => model.HoTen, new { @class = "form-control", style = "border-radius: 5px; width: 100%;", required = "required" })
                                    @Html.ValidationMessageFor(model => model.HoTen, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Giới tính:</strong></td>
                                <td>
                                    <div class="checkbox">
                                        Nam @Html.RadioButtonFor(model => model.GioiTinh, "True", new { @checked = "checked" }) &nbsp;
                                        Nữ @Html.RadioButtonFor(model => model.GioiTinh, "False")
                                        @Html.ValidationMessageFor(model => model.GioiTinh, "", new { @class = "text-danger" })
                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Số điện thoại:</strong></td>
                                <td>
                                    @Html.TextBoxFor(model => model.SDT, new
                                    {
                                        @class = "form-control",
                                        style = "border-radius: 5px; width: 100%;",
                                        required = "required",
                                        pattern = @"^\d{10}$",
                                        title = "Số điện thoại phải có 10 chữ số."
                                    })
                                    @Html.ValidationMessageFor(model => model.SDT, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Email:</strong></td>
                                <td>
                                    @Html.TextBoxFor(model => model.Email, new
                                    {
                                        @class = "form-control",
                                        style = "border-radius: 5px; width: 100%;",
                                        required = "required",
                                        type = "email"
                                    })
                                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Mật khẩu:</strong></td>
                                <td>
                                    @Html.PasswordFor(model => model.MatKhau, new
                                    {
                                        @class = "form-control",
                                        style = "border-radius: 5px; width: 100%;",
                                        required = "required",
                                        minlength = "6",
                                        title = "Mật khẩu phải có ít nhất 6 ký tự."
                                    })
                                    @Html.ValidationMessageFor(model => model.MatKhau, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Địa chỉ:</strong></td>
                                <td>
                                    @Html.TextBoxFor(model => model.DiaChi, new { @class = "form-control", style = "border-radius: 5px; width: 100%;" })
                                    @Html.ValidationMessageFor(model => model.DiaChi, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Ảnh đại diện:</strong></td>
                                <td>
                                    <input type="file" style="height:30px;" name="Avatar" accept="image/*" required />
                                    @Html.ValidationMessageFor(model => model.AnhDaiDien, "", new { @class = "text-danger" })
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Vai trò:</strong></td>
                                <td>
                                    <div class="checkbox">
                                        Khách hàng @Html.RadioButtonFor(model => model.VaiTro, "KH", new { @checked = "checked" }) &nbsp;
                                        Nhân viên @Html.RadioButtonFor(model => model.VaiTro, "NV") &nbsp;
                                        Admin @Html.RadioButtonFor(model => model.VaiTro, "AD")
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <div class="form-group mt-3">
                            <div class="text-center d-flex justify-content-center gap-2">
                                <a href="@Url.Action("Index", "NV_TaiKhoans_23TH0014")" class="btn" style="border-radius: 5px; background: #fe6161; color: white">
                                    Quay lại
                                </a>
                                <input type="submit" value="Thêm" class="btn" style="border-radius: 5px; background: #fd710d; color: white" />
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
