@model IEnumerable<object>
@{
    ViewBag.Title = "Thống kê";
    Layout = "~/Views/Shared/_LayoutNV.cshtml";
    <link href="~/Content/Style.css" rel="stylesheet" />
    decimal tong = 0;
    var use = Session["use"] as QLDT_23TH0014.Models.NguoiDung;
}
@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Vẽ biểu đồ top sản phẩm
        const spLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.TopSanPhamLabels));
        const spData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.TopSanPhamData));

        const ctxSP = document.getElementById('spChart').getContext('2d');
        new Chart(ctxSP, {
            type: 'bar',
            data: {
                labels: spLabels,
                datasets: [{
                    label: 'Số lượng đặt mua',
                    data: spData,
                    backgroundColor: '#fd710d'
                }]
            }
        });

        // Vẽ biểu đồ doanh thu theo tháng
        const thangLabels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ThangLabels));
        const doanhThuData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.DoanhThuData));

        const ctxThang = document.getElementById('thangChart').getContext('2d');
        new Chart(ctxThang, {
            type: 'line',
            data: {
                labels: thangLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: doanhThuData,
                    borderColor: '#fe6161',
                }]
            }
        });

        // Hàm tự di chuyển đến mục doanh thu theo sản phẩm khi người dùng tìm kiếm
        document.addEventListener("DOMContentLoaded", function () {
            // Kiểm tra nếu có tham số tìm kiếm trên URL
            if (window.location.search.length > 0) {
                setTimeout(() => {
                    document.getElementById("product-revenue").scrollIntoView({ behavior: "smooth" });
                }, 0);
            }
        });

        // Hàm reset thông tin các ô tìm kiếm
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("reset-button").addEventListener("click", function (event) {
                event.preventDefault(); // Ngăn chặn hành động mặc định

                // Lấy form
                let form = document.getElementById("search-form");

                // Xóa giá trị của tất cả input
                form.querySelectorAll("input").forEach(input => {
                    if (input.type === "date") {
                        input.value = "";
                    }
                    if (input.type === "checkbox") {
                        input.checked = false;
                    }
                });

                // Xóa các giá trị trong URL (nếu có)
                window.history.replaceState(null, null, window.location.pathname);

            });
        });
    </script>
}

<!--Thống kê tình trạng đơn hàng -->
<div class="row mb-4 pt-2">
    @{
        if (use.VaiTro == "AD")
        {
            <div class="col-md-3">
                <div class="card bg-secondary text-white">
                    <div class="card-body">
                        <div>Đơn chờ xác nhận: @ViewBag.SLDonChoXacNhan</div>
                        <div class="fw-bold" style="font-size: 20px">@String.Format("{0:N0}", ViewBag.GTDonChoXacNhan) đ</div>
                        <div style="text-align: right"><a href="@Url.Action("Index", "NV_DonHangs_23TH0014", new { TinhTrang = 0 })" , style="color: white;">Chi tiết</a></div>
                    </div>
                </div>
            </div>
        }
    }
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div>Đơn đang giao: @ViewBag.SLDonDangGiao</div>
                <div class="fw-bold" style="font-size: 20px">@String.Format("{0:N0}", ViewBag.GTDonDangGiao) đ</div>
                <div style="text-align: right"><a href="@Url.Action("Index", "NV_DonHangs_23TH0014", new { TinhTrang = 1 })" , style="color: white;">Chi tiết</a></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div>Đơn thành công: @ViewBag.SLDonThanhCong</div>
                <div class="fw-bold" style="font-size: 20px">@String.Format("{0:N0}", ViewBag.GTDonThanhCong) đ</div>
                <div style="text-align: right"><a href="@Url.Action("Index", "NV_DonHangs_23TH0014", new { TinhTrang = 2 })" , style="color: white;">Chi tiết</a></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <div>Đơn đã hủy: @ViewBag.SLDonDaHuy</div>
                <div class="fw-bold" style="font-size: 20px">@String.Format("{0:N0}", ViewBag.GTDonDaHuy) đ</div>
                <div style="text-align: right"><a href="@Url.Action("Index", "NV_DonHangs_23TH0014", new { TinhTrang = 3 })" , style="color: white;">Chi tiết</a></div>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ sản phẩm bán chạy và doanh thu-->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="card shadow-lg pb-2">
            <div class="card-header brand-header text-center">Top 5 sản phẩm bán chạy</div>
            <div class="card-body">
                <canvas id="spChart"></canvas>
                <div style="text-align: right" class="pe-2 pt-2"><a href="@Url.Action("SanPhamBanChay_NC", "NV_ThongKes_23TH0014")">Xem thêm</a></div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-lg pb-2">
            <div class="card-header brand-header text-center">Doanh thu 6 tháng gần nhất</div>
            <div class="card-body">
                <canvas id="thangChart"></canvas>
                <div style="text-align: right" class="pe-2 pt-2"><a href="@Url.Action("DoanhThuTheoKy_NC", "NV_ThongKes_23TH0014")">Xem thêm</a></div>
            </div>
        </div>
    </div>
</div>

<!-- Doanh thu theo sản phẩm và hãng sản xuất -->
<div class="container">
    <div class="card shadow-lg pb-4 mt-4" style="max-width: 100%; margin: 0 auto;">
        <div class="card-header brand-header text-center fw-bold">
            Doanh thu theo sản phẩm và hãng sản xuất
        </div>
        <div class="card-body" id="product-revenue">
            @using (Html.BeginForm("Index", "NV_ThongKes_23TH0014", FormMethod.Get, new { @class = "mb-4", id = "search-form" }))
            {
                <div class="table-responsive">
                    <table class="table1" align="center">
                        <tr>
                            <th style="padding-left: 10px; padding-right: 10px;">Từ ngày</th>
                            <th style="padding-left: 10px; padding-right: 10px;">Đến ngày</th>
                            <th colspan="6" style="padding-left: 10px; padding-right: 10px;">Hãng sản xuất</th>
                            <th colspan="2" style="padding-left: 10px; padding-right: 10px;"></th>
                        </tr>
                        <tr>
                            <td style="padding-left: 10px; padding-right: 10px;">
                                <input type="date" name="tuNgay" value="@(ViewBag.TuNgay != null ? ((DateTime)ViewBag.TuNgay).ToString("yyyy-MM-dd") : "")" class="form-control" />
                            </td>
                            <td style="padding-left: 10px; padding-right: 10px;">
                                <input type="date" name="denNgay" value="@(ViewBag.DenNgay != null ? ((DateTime)ViewBag.DenNgay).ToString("yyyy-MM-dd") : "")" class="form-control" />
                            </td>
                            @{
                                var hsxList = ViewBag.HSXList as List<SelectListItem>;
                                string[] selectedHSX = ViewBag.selectedHSX;
                            }
                            @foreach (var hsx in hsxList)
                            {
                                <td style="padding-left: 10px; padding-right: 10px;">
                                    <input class="form-check-input" type="checkbox" name="HSX" value="@hsx.Value" id="hsx_@hsx.Value"
                                           @(selectedHSX.Contains(hsx.Value) ? "checked" : "") style="transform: scale(1.3); margin-right: 5px" />
                                    <label class="form-check-label" for="hsx_@hsx.Value">@hsx.Text</label>
                                </td>
                            }
                            <td colspan="2" style="padding-left: 10px; padding-right: 10px;">
                                <button type="reset" class="btn me-3" style="background: #fd710d; color: white" id="reset-button">Nhập lại</button>
                                <button type="submit" class="btn" style="background: #fe6161; color: white;">Thống kê</button>
                            </td>
                        </tr>
                    </table>
                </div>
            }
            <div class="table-responsive">
                <table class="table table-hover table-bordered text-center align-middle mb-0">
                    <thead style="font-weight: bold">
                        <tr>
                            <th>STT</th>
                            <th>Mã sản phẩm</th>
                            <th>Tên sản phẩm</th>
                            <th>Số lượng bán</th>
                            <th>Giá bán</th>
                            <th>Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var hsx in Model)
                            {
                                int stt = 1;
                                var tenHSX = hsx.GetType().GetProperty("TenHSX").GetValue(hsx, null);
                                var tongTienHSX = hsx.GetType().GetProperty("TongTien").GetValue(hsx, null);
                                var sanPhams = (IEnumerable<dynamic>)hsx.GetType().GetProperty("SanPhams").GetValue(hsx, null);
                                tong += Convert.ToDecimal(tongTienHSX);
                                <tr class="table1 fw-bold border-none" style="background-color: #ffb784">
                                    <td colspan="5" class="text-start">
                                        @tenHSX.ToString().ToUpper()
                                    </td>
                                    <td class="text-end" style="color: red">
                                        @String.Format("{0:N0} đ", tongTienHSX)
                                    </td>
                                </tr>
                                foreach (var sp in sanPhams)
                                {
                                    var maSP = sp.GetType().GetProperty("MaSP").GetValue(sp, null);
                                    var tenSP = sp.GetType().GetProperty("TenSP").GetValue(sp, null);
                                    var soLuong = sp.GetType().GetProperty("TongSoLuong").GetValue(sp, null);
                                    var giaBan = sp.GetType().GetProperty("GiaBan").GetValue(sp, null);
                                    var tongTien = sp.GetType().GetProperty("TongTien").GetValue(sp, null);
                                    <tr>
                                        <td>@(stt++)</td>
                                        <td>@maSP</td>
                                        <td>@tenSP</td>
                                        <td>@soLuong</td>
                                        <td>@String.Format("{0:N0} đ", giaBan)</td>
                                        <td class="text-end fw-bold">@String.Format("{0:N0} đ", tongTien)</td>
                                    </tr>
                                }
                            }
                        }
                        <tr class="fw-bold" style="background-color: #ffd1a6">
                            <td colspan="5" class="text-end" style="color: red">TỔNG DOANH THU:</td>
                            <td class="text-end" style="color: red">@String.Format("{0:N0} đ", tong)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>



